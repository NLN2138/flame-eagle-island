<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>炎鷲橙果島 - 3D 沈浸式學術與 AI 應用生態系</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Noto Sans TC', sans-serif;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #090d16;
            color: #f8fafc;
        }
        #canvas-container {
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0; left: 0;
            z-index: 1;
        }
        /* 頂部介面 */
        .ui-header {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            text-align: center;
            background: rgba(15, 23, 42, 0.75);
            border: 1px solid rgba(59, 130, 246, 0.3);
            padding: 12px 25px;
            border-radius: 30px;
            backdrop-filter: blur(10px);
            pointer-events: auto;
        }
        .ui-header h1 {
            font-size: 1.4rem;
            color: #60a5fa;
            letter-spacing: 1px;
        }
        .ui-header p {
            font-size: 0.8rem;
            color: #94a3b8;
            margin-top: 2px;
        }
        /* 操作提示 */
        .ui-hint {
            position: absolute;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            background: rgba(30, 41, 59, 0.85);
            border: 1px solid rgba(148, 163, 184, 0.2);
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 0.85rem;
            color: #cbd5e1;
            pointer-events: none;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }
        /* 互動資訊面板 (Modal / Card) */
        .info-panel {
            position: absolute;
            top: 100px;
            right: 30px;
            width: 380px;
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(59, 130, 246, 0.4);
            border-radius: 16px;
            padding: 25px;
            z-index: 20;
            backdrop-filter: blur(12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.6);
            display: none;
            animation: fadeIn 0.3s ease;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .info-panel h2 {
            color: #60a5fa;
            font-size: 1.3rem;
            margin-bottom: 10px;
        }
        .info-panel p {
            color: #94a3b8;
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 12px;
        }
        .info-panel ul {
            padding-left: 18px;
            color: #cbd5e1;
            font-size: 0.88rem;
            margin-bottom: 15px;
        }
        .info-panel li { margin-bottom: 6px; }
        .close-panel {
            position: absolute;
            top: 15px; right: 15px;
            background: none; border: none;
            color: #94a3b8; font-size: 1.4rem;
            cursor: pointer;
        }
        .close-panel:hover { color: white; }
        .btn-link {
            display: inline-block;
            background: #3b82f6;
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            margin-top: 5px;
            transition: background 0.2s;
        }
        .btn-link:hover { background: #2563eb; }
    </style>
</head>
<body>

    <div class="ui-header">
        <h1>🦅 炎鷲橙果島 (Flame-Eagle Orange-Fruit Island)</h1>
        <p>3D 互動學術研究與 AI 應用生態系</p>
    </div>

    <div class="ui-hint">💡 操作提示：滑鼠可拖曳旋轉 3D 視角、滾輪縮放；**點擊島上 3D 建築物**以探索內容！</div>

    <div id="infoPanel" class="info-panel">
        <button class="close-panel" onclick="closeInfo()">×</button>
        <div id="panelContent"></div>
    </div>

    <div id="canvas-container"></div>

    <!-- 載入 Three.js 3D 引擎 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // --- 1. 3D 場景初始化 ---
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x090d16, 0.035);

        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 18, 24);
        camera.lookAt(0, 0, 0);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        container.appendChild(renderer.domElement);

        // --- 2. 光源設定 ---
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);

        const dirLight = new THREE.DirectionalLight(0x60a5fa, 1.2);
        dirLight.position.set(15, 25, 15);
        dirLight.castShadow = true;
        scene.add(dirLight);

        const pointLight = new THREE.PointLight(0x3b82f6, 2, 30);
        pointLight.position.set(0, 10, 0);
        scene.add(pointLight);

        // --- 3. 建立 3D 島嶼與建築群 ---
        const interactiveObjects = [];

        // 島嶼基底 (浮空六角形)
        const islandGeo = new THREE.CylinderGeometry(10, 8, 2, 6);
        const islandMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.4 });
        const island = new THREE.Mesh(islandGeo, islandMat);
        island.position.y = -1;
        island.receiveShadow = true;
        scene.add(island);

        // 島嶼發光邊緣環
        const ringGeo = new THREE.RingGeometry(9.9, 10.2, 6);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0x3b82f6, side: THREE.DoubleSide });
        const ring = new THREE.Mesh(ringGeo, ringMat);
        ring.rotation.x = Math.PI / 2;
        ring.position.y = 0.01;
        scene.add(ring);

        // 建築資料與 3D 物件生成
        const buildingsData = [
            {
                id: 'hub',
                name: '🌋 島主觀測站 (Overview)',
                color: 0x3b82f6,
                pos: [0, 0.8, 0],
                size: [2.5, 2, 2.5],
                shape: 'cylinder',
                content: `
                    <h2>🌋 島主觀測站</h2>
                    <p><strong>炎鷲橙果島</strong> 結合深層語言學研究、計量句法分析（MDD）與前線 AI 應用。</p>
                    <ul>
                        <li><strong>學術基石</strong>：依存距離、南島語句法。</li>
                        <li><strong>系統落地</strong>：3 大線上智慧檢測平台。</li>
                        <li><strong>隱私合規</strong>：嚴格去識別化學術展示。</li>
                    </ul>
                `
            },
            {
                id: 'papers',
                name: '📚 學術殿堂 (Research Papers)',
                color: 0x10b981,
                pos: [-4, 1, -2],
                size: [2.2, 2.5, 2.2],
                shape: 'box',
                content: `
                    <h2>📚 學術殿堂：研究著作</h2>
                    <p>收錄於 <code>01 學術研究/00 研究成果島/01 論文</code>：</p>
                    <p><strong>1. 華語文評量材料句法複雜度與自動檢測</strong></p>
                    <p style="font-size:0.82rem; color:#94a3b8;">核心指標：依存距離 (DD)、平均依存距離 (MDD)、最大依存距離 (MaxDD)。</p>
                    <p style="margin-top:8px;"><strong>2. 南島語句法與限定詞組省略理論研究</strong></p>
                    <p style="font-size:0.82rem; color:#94a3b8;">探討 Saisiyat 語法、生成語法與空代名詞。</p>
                `
            },
            {
                id: 'systems',
                name: '⚡ 實踐工坊 (Online Systems)',
                color: 0xf59e0b,
                pos: [4, 1, -2],
                size: [2.2, 2.8, 2.2],
                shape: 'box',
                content: `
                    <h2>⚡ 實踐工坊：線上應用系統</h2>
                    <p>學術理論轉化為生產力工具的現場：</p>
                    <p style="margin-top:6px;"><strong>1. AI 華語文句法難度自動檢測</strong></p>
                    <a href="https://twmddanalyzer.streamlit.app/" target="_blank" class="btn-link">🚀 啟動檢測系統</a>
                    <p style="margin-top:10px;"><strong>2. 自動語音轉文字與語料庫分析</strong></p>
                    <a href="https://twpoliticolstt.streamlit.app/" target="_blank" class="btn-link">🚀 啟動分析系統</a>
                    <p style="margin-top:10px;"><strong>3. 台灣中小學英語測驗單字頻率檢索</strong></p>
                    <a href="https://twvocfreqexam.streamlit.app/" target="_blank" class="btn-link">🚀 啟動檢索系統</a>
                `
            },
            {
                id: 'synergy',
                name: '🔗 知識協作網 (Synergy)',
                color: 0x8b5cf6,
                pos: [0, 0.6, 4],
                size: [2, 1.2, 2],
                shape: 'box',
                content: `
                    <h2>🔗 知識協作網：研發閉環</h2>
                    <p>見證基礎研究如何轉化為前端工具：</p>
                    <pre style="background: #0f172a; padding: 10px; border-radius: 6px; color: #60a5fa; font-size: 0.78rem; margin-top: 8px;">
[ 語言學理論 & 句法研究 ]
         │
         ▼ 演算法建模 (MDD / MaxDD)
[ 系統實作 ]
   ├──► AI 華語句法檢測
   ├──► 語音轉文字與語料庫
   └──► 英語字頻檢索
                    </pre>
                `
            }
        ];

        buildingsData.forEach(data => {
            let geo;
            if (data.shape === 'cylinder') {
                geo = new THREE.CylinderGeometry(data.size[0]/2, data.size[0]/2, data.size[1], 16);
            } else {
                geo = new THREE.BoxGeometry(data.size[0], data.size[1], data.size[2]);
            }
            const mat = new THREE.MeshStandardMaterial({ 
                color: data.color, 
                roughness: 0.3, 
                metalness: 0.2 
            });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(data.pos[0], data.pos[1], data.pos[2]);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            mesh.userData = { id: data.id, content: data.content, originalY: data.pos[1] };
            
            scene.add(mesh);
            interactiveObjects.push(mesh);
        });

        // --- 4. 滑鼠互動與點擊事件 (Raycasting) ---
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        let hoveredMesh = null;

        window.addEventListener('mousemove', (event) => {
            mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveObjects);

            if (intersects.length > 0) {
                document.body.style.cursor = 'pointer';
                const hitMesh = intersects[0].object;
                if (hoveredMesh !== hitMesh) {
                    if (hoveredMesh) hoveredMesh.scale.set(1, 1, 1);
                    hoveredMesh = hitMesh;
                    hoveredMesh.scale.set(1.08, 1.08, 1.08);
                }
            } else {
                document.body.style.cursor = 'default';
                if (hoveredMesh) {
                    hoveredMesh.scale.set(1, 1, 1);
                    hoveredMesh = null;
                }
            }
        });

        window.addEventListener('click', () => {
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObjects(interactiveObjects);

            if (intersects.length > 0) {
                const hitMesh = intersects[0].object;
                showInfo(hitMesh.userData.content);
                
                // 點擊時攝影機平滑轉向該建築
                gsapCameraMove(hitMesh.position.x, hitMesh.position.z);
            }
        });

        function showInfo(htmlContent) {
            const panel = document.getElementById('infoPanel');
            const content = document.getElementById('panelContent');
            content.innerHTML = htmlContent;
            panel.style.display = 'block';
        }

        function closeInfo() {
            document.getElementById('infoPanel').style.display = 'none';
        }

        // 簡單的視角轉動緩動
        function gsapCameraMove(targetX, targetZ) {
            let startX = camera.position.x;
            let startZ = camera.position.z;
            let destX = targetX * 0.8;
            let destZ = targetZ * 0.8 + 16;
            let progress = 0;

            function anim() {
                progress += 0.04;
                camera.position.x += (destX - camera.position.x) * 0.1;
                camera.position.z += (destZ - camera.position.z) * 0.1;
                camera.lookAt(0, 0, 0);
                if (progress < 1) requestAnimationFrame(anim);
            }
            anim();
        }

        // --- 5. 動態渲染迴圈 (島嶼浮動特效) ---
        let clock = new THREE.Clock();
        function animate() {
            requestAnimationFrame(animate);
            let elapsedTime = clock.getElapsedTime();

            // 整座島嶼輕微上下浮動
            island.position.y = -1 + Math.sin(elapsedTime * 1.5) * 0.15;
            ring.position.y = island.position.y + 1.01;

            interactiveObjects.forEach((obj, idx) => {
                obj.position.y = obj.userData.originalY + Math.sin(elapsedTime * 2 + idx) * 0.08;
            });

            renderer.render(scene, camera);
        }
        animate();

        // 視窗大小變更響應
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
